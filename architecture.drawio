<mxfile host="app.diagrams.net" modified="2026-06-01T00:00:00.000Z" agent="5.0" version="24.0.0">
  <diagram name="AI Sales Coach Architecture" id="architecture">
    <mxGraphModel dx="1434" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="AI Sales Coach - Voice Live Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
            <mxGeometry x="350" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        
        <!-- Browser Layer -->
        <mxCell id="browser-container" value="Browser" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="680" height="300" as="geometry" />
        </mxCell>

        <mxCell id="ui" value="index.html + app_with_avatar.js&#xa;&#xa;• Avatar video display (WebRTC &lt;video&gt;)&#xa;• Transcript bubbles (PRESENTER / AVATAR)&#xa;• Connect / Start / Stop controls&#xa;• Coaching report panel&#xa;• Visual Presence report section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="browser-container">
          <mxGeometry x="30" y="40" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="pcm-capture" value="AudioWorklet + Frame Capture&#xa;&#xa;• getUserMedia mic capture&#xa;• PCM16 conversion + base64 encode&#xa;• Browser AEC enabled&#xa;• Webcam JPEG snapshot every 30s&#xa;• Evenly sampled (max 20 frames)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="browser-container">
          <mxGeometry x="30" y="180" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="vl-ws-client" value="Voice Live WebSocket Client&#xa;&#xa;• wss://…/voice-live/realtime&#xa;• input_audio_buffer.append (PCM16)&#xa;• response.audio_transcript.delta&#xa;• response.content_part.done&#xa;• conversation.item.created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="browser-container">
          <mxGeometry x="310" y="40" width="230" height="140" as="geometry" />
        </mxCell>

        <mxCell id="webrtc-client" value="WebRTC (recvonly)&#xa;&#xa;• SDP offer/answer via VL WS&#xa;• ICE: relay.communication.microsoft.com&#xa;• video track → &lt;video&gt; element&#xa;• audio track → avatar speaker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="browser-container">
          <mxGeometry x="310" y="200" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rest-client" value="REST Client&#xa;&#xa;• GET /api/voice-live/config&#xa;• POST /api/session/start&#xa;• POST /api/session/{id}/analyze&#xa;• DELETE /api/session/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="browser-container">
          <mxGeometry x="560" y="40" width="100" height="130" as="geometry" />
        </mxCell>

        <!-- FastAPI Backend -->
        <mxCell id="backend-container" value="FastAPI Backend" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="680" height="240" as="geometry" />
        </mxCell>

        <mxCell id="fastapi" value="main.py&#xa;&#xa;• GET /api/voice-live/config&#xa;• POST /api/session/start&#xa;• POST /api/session/{id}/analyze&#xa;• DELETE /api/session/{id}&#xa;• GET /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="backend-container">
          <mxGeometry x="30" y="40" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="SalesCoachAgent&#xa;(sales_coach_agent.py)&#xa;&#xa;• analyze_presentation()&#xa;• GPT-4.1 6-dimension scoring&#xa;• Emotional tone analysis&#xa;• analyze_visual_appearance()&#xa;• GPT-4.1 vision: expressions,&#xa;  eye contact, posture, appearance&#xa;• Rule violation checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="backend-container">
          <mxGeometry x="280" y="40" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="config-box" value="config.py + rules.json&#xa;&#xa;• Voice Live WS URL builder&#xa;• AIProjectClient (DefaultAzureCredential)&#xa;• Custom coaching rules&#xa;• Session state dict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="backend-container">
          <mxGeometry x="530" y="40" width="130" height="150" as="geometry" />
        </mxCell>

        <!-- Azure Services -->
        <mxCell id="azure-container" value="Azure (swedencentral)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="620" height="610" as="geometry" />
        </mxCell>

        <mxCell id="voice-live" value="Azure AI Voice Live&#xa;(gpt-4.1 deployment)&#xa;&#xa;• Bidirectional speech WebSocket&#xa;• Server VAD (threshold 0.7)&#xa;• Server-side AEC&#xa;• STT: Azure Speech engine&#xa;• TTS: en-US-Ava:DragonHDLatestNeural&#xa;• Avatar: lisa / casual-sitting&#xa;• WebRTC media relay (TURN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontStyle=1" vertex="1" parent="azure-container">
          <mxGeometry x="40" y="40" width="250" height="220" as="geometry" />
        </mxCell>

        <mxCell id="vl-session" value="Voice Live Session Config&#xa;&#xa;• turn_detection: server_vad&#xa;• prefix_padding_ms: 300&#xa;• silence_duration_ms: 800&#xa;• create_response: true&#xa;• interrupt_response: true&#xa;• echo_cancellation: enabled&#xa;• instructions: sales coach persona" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="azure-container">
          <mxGeometry x="320" y="40" width="260" height="220" as="geometry" />
        </mxCell>

        <mxCell id="gpt4o-report" value="Azure AI Foundry&#xa;(GPT-4.1 deployment)&#xa;&#xa;• Post-session coaching analysis&#xa;• 6 dimension scores (1-10)&#xa;• Emotional tone (sentiment, confidence,&#xa;  energy, key moments)&#xa;• Visual presence (expressions, eye&#xa;  contact, posture, appearance, arc)&#xa;• Strengths / improvements&#xa;• Rule violation detection&#xa;• Next steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontStyle=1" vertex="1" parent="azure-container">
          <mxGeometry x="40" y="290" width="260" height="200" as="geometry" />
        </mxCell>

        <mxCell id="data-flow" value="Data Flow Summary&#xa;&#xa;1. Browser fetches VL config from FastAPI&#xa;2. Browser opens VL WebSocket directly&#xa;3. Mic PCM streamed → Voice Live (STT+LLM+TTS)&#xa;4. WebRTC carries avatar video+audio → Browser&#xa;5. Transcript events → conversation bubbles&#xa;6. Webcam frames captured every 30s (in-memory)&#xa;7. Stop → POST /analyze (transcript + frames)&#xa;8. GPT-4.1: transcript report + vision analysis&#xa;9. Report + Visual Presence displayed in browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="azure-container">
          <mxGeometry x="320" y="290" width="260" height="200" as="geometry" />
        </mxCell>

        <!-- Connections: Browser → Voice Live WebSocket (direct) -->
        <mxCell id="edge-vl-ws" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0066CC;" edge="1" parent="1" source="vl-ws-client" target="voice-live">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-vl-ws-label" value="Voice Live WebSocket&#xa;PCM audio + events" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1" vertex="1" connectable="0" parent="edge-vl-ws">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-15" /></mxGeometry>
        </mxCell>

        <!-- Voice Live → WebRTC → Browser -->
        <mxCell id="edge-webrtc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9900CC;dashed=1;" edge="1" parent="1" source="voice-live" target="webrtc-client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-webrtc-label" value="WebRTC&#xa;avatar video + audio" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1" vertex="1" connectable="0" parent="edge-webrtc">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-15" /></mxGeometry>
        </mxCell>

        <!-- Browser REST → FastAPI -->
        <mxCell id="edge-rest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#FF6600;" edge="1" parent="1" source="rest-client" target="fastapi">
          <mxGeometry relative="1" as="geometry" />
