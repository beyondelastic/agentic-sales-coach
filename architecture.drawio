        <mxCell id="edge-agent-gpt4o" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#FF6600;" edge="1" parent="1" source="agent" target="gpt4o-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-agent-gpt4o-label" value="GPT-4.1 API&#xa;(report + vision analysis)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1" vertex="1" connectable="0" parent="edge-agent-gpt4o">
